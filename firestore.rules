rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions autentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 1. Koleksi Profil Mahasiswa (mendukung 'students' dan 'mahasiswa')
    match /students/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /mahasiswa/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // 2. Koleksi Presensi / Kehadiran (mendukung 'attendance' dan 'absensi')
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /absensi/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // 3. Index Publik Verifikasi NIM
    match /nim_index/{nim} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. Default fallback aman untuk pengguna terautentikasi
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
