    "Setting": {
      "title": "Setting",
      "description": "Pengaturan umum sistem presensi",
      "type": "object",
      "properties": {
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "lateToleranceMinutes": { "type": "number" },
        "minAttendancePercent": { "type": "number" },
        "maintenanceMode": { "type": "boolean" }
      }
    }
