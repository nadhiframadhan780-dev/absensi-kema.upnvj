{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Profil mahasiswa UPNVJ",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "nim": { "type": "string" },
        "email": { "type": "string" },
        "fakultas": { "type": "string" },
        "prodi": { "type": "string" },
        "angkatan": { "type": "string" },
        "semester": { "type": "string" },
