  "firestore": {
    "/students/{uid}": {
      "schema": "Student",
      "description": "Profil mahasiswa terdaftar"
    },
    "/attendance/{docId}": {
      "schema": "Attendance",
      "description": "Rekap kehadiran mahasiswa"
    },
    "/leaveRequests/{id}": {
      "schema": "LeaveRequest",
      "description": "Pengajuan izin, sakit, dan surat dispensasi resmi"
    },
    "/admins/{uid}": {
      "schema": "AdminUser",
      "description": "Daftar pengelola dan dosen"
    },
    "/courses/{id}": {
      "schema": "Course",
      "description": "Mata kuliah terjadwal"
    },
    "/sessions/{id}": {
      "schema": "Session",
      "description": "Sesi presensi perkuliahan"
    },
    "/announcements/{id}": {
      "schema": "Announcement",
      "description": "Pemberitahuan akademik"
    },
    "/auditLogs/{id}": {
      "schema": "AuditLog",
      "description": "Jejak audit dan keamanan"
    },
    "/settings/{docId}": {
      "schema": "Setting",
      "description": "Konfigurasi sistem global"
    }
  }
