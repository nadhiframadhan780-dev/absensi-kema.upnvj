        "metode": { "type": "string" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Pengajuan surat izin, sakit, atau dispensasi resmi",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nim": { "type": "string" },
        "nama": { "type": "string" },
        "fakultas": { "type": "string" },
        "prodi": { "type": "string" },
        "mataKuliah": { "type": "string" },
        "dosen": { "type": "string" },
        "jenis": { "type": "string" },
        "tanggalMulai": { "type": "string" },
        "tanggalSelesai": { "type": "string" },
        "alasan": { "type": "string" },
