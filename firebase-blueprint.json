        "target": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Log audit keamanan dan aktivitas admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nama": { "type": "string" },
        "aksi": { "type": "string" },
        "detail": { "type": "string" },
        "ip": { "type": "string" },
        "createdAt": { "type": "string" }
      }
